{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hive.config.schema.json",
  "title": "HiveConfig",
  "description": "Hive workspace configuration",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON schema reference"
    },
    "opencode": {
      "description": "Global OpenCode configuration shared across templates",
      "type": "object",
      "properties": {
        "token": {
          "description": "Authentication token or environment reference for OpenCode",
          "type": "string"
        },
        "defaultProvider": {
          "description": "Default provider identifier when templates omit one",
          "type": "string",
          "minLength": 1
        },
        "defaultModel": {
          "description": "Fallback model identifier used when templates omit one",
          "type": "string"
        },
        "defaultMode": {
          "description": "Default OpenCode agent mode when creating new cells",
          "type": "string",
          "enum": ["plan", "build"]
        }
      },
      "additionalProperties": false
    },
    "promptSources": {
      "description": "Glob patterns pointing to prompt fragments used when assembling agent briefs",
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "templates": {
      "description": "Available cell templates",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "description": "Unique template identifier",
            "type": "string"
          },
          "label": {
            "description": "Display name for template",
            "type": "string"
          },
          "type": {
            "description": "Template type",
            "type": "string",
            "const": "manual"
          },
          "services": {
            "description": "Services required by this template",
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "additionalProperties": {
              "description": "Service definitions; only process services are executable",
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "description": "Service type",
                      "default": "process",
                      "type": "string",
                      "const": "process"
                    },
                    "run": {
                      "description": "Command to run service",
                      "type": "string"
                    },
                    "setup": {
                      "description": "Setup commands to run before main command",
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "cwd": {
                      "description": "Working directory for service",
                      "type": "string"
                    },
                    "env": {
                      "description": "Environment variables",
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "audio": {
                      "description": "Host audio access for the service",
                      "type": "object",
                      "properties": {
                        "input": {
                          "description": "Allow the service to receive host audio (defaults to false)",
                          "type": "boolean"
                        },
                        "output": {
                          "description": "Allow the service to play audio on the host (defaults to true)",
                          "type": "boolean"
                        }
                      },
                      "additionalProperties": false
                    },
                    "ports": {
                      "description": "Named ports allocated for the service",
                      "type": "object",
                      "propertyNames": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[A-Za-z0-9_-]+$"
                      },
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "port": {
                            "description": "Bind this exact host port instead of allocating one",
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 65535
                          },
                          "primary": {
                            "description": "Use as the compatibility port",
                            "type": "boolean"
                          },
                          "protocol": {
                            "description": "How clients should connect to the port (defaults to http)",
                            "type": "string",
                            "enum": ["http", "https", "tcp"]
                          },
                          "viewer": {
                            "description": "Show this HTTP or HTTPS port in the browser viewer (defaults to true)",
                            "type": "boolean"
                          }
                        },
                        "additionalProperties": false,
                        "description": "Named port definition"
                      }
                    },
                    "dependsOn": {
                      "description": "Services that must be ready before this service starts",
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "readiness": {
                      "description": "Readiness probe run after process spawn",
                      "type": "object",
                      "properties": {
                        "checks": {
                          "description": "Checks that must all pass before the service is ready",
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "oneOf": [
                              {
                                "type": "object",
                                "properties": {
                                  "type": {
                                    "type": "string",
                                    "const": "tcp",
                                    "description": "Readiness probe type"
                                  },
                                  "port": {
                                    "description": "Named service port to probe",
                                    "type": "string",
                                    "minLength": 1,
                                    "pattern": "^[A-Za-z0-9_-]+$"
                                  },
                                  "host": {
                                    "description": "Probe host (defaults to 127.0.0.1)",
                                    "type": "string",
                                    "minLength": 1
                                  }
                                },
                                "required": ["type", "port"],
                                "additionalProperties": false
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "type": {
                                    "type": "string",
                                    "const": "http",
                                    "description": "Readiness probe type"
                                  },
                                  "port": {
                                    "description": "Named service port to probe",
                                    "type": "string",
                                    "minLength": 1,
                                    "pattern": "^[A-Za-z0-9_-]+$"
                                  },
                                  "host": {
                                    "description": "Probe host (defaults to 127.0.0.1)",
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "path": {
                                    "description": "HTTP path to probe (defaults to /)",
                                    "type": "string",
                                    "pattern": "^\\/.*"
                                  },
                                  "method": {
                                    "type": "string",
                                    "enum": ["GET", "HEAD"],
                                    "description": "HTTP readiness method"
                                  },
                                  "protocol": {
                                    "type": "string",
                                    "enum": ["http", "https"],
                                    "description": "HTTP readiness protocol"
                                  }
                                },
                                "required": ["type", "port"],
                                "additionalProperties": false
                              }
                            ]
                          }
                        },
                        "intervalMs": {
                          "description": "Milliseconds between readiness attempts",
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": ["checks"],
                      "additionalProperties": false
                    },
                    "readyTimeoutMs": {
                      "description": "Readiness deadline in milliseconds",
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "stop": {
                      "description": "Command to gracefully stop service",
                      "type": "string"
                    }
                  },
                  "required": ["type", "run"],
                  "additionalProperties": false,
                  "description": "Service definition"
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "description": "Reserved service type; execution is not implemented",
                      "type": "string",
                      "const": "docker"
                    },
                    "image": {
                      "description": "Docker image to use",
                      "type": "string"
                    },
                    "command": {
                      "description": "Command to override default",
                      "type": "string"
                    },
                    "ports": {
                      "description": "Port mappings (e.g., '3000:3000')",
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "env": {
                      "description": "Environment variables",
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "volumes": {
                      "description": "Volume mappings",
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "readyTimeoutMs": {
                      "description": "Milliseconds to wait for service to be ready",
                      "type": "number"
                    }
                  },
                  "required": ["type", "image"],
                  "additionalProperties": false,
                  "description": "Service definition"
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "description": "Reserved service type; execution is not implemented",
                      "type": "string",
                      "const": "compose"
                    },
                    "file": {
                      "description": "Path to docker-compose.yml",
                      "type": "string"
                    },
                    "services": {
                      "description": "Specific services to run",
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "env": {
                      "description": "Environment variables",
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  },
                  "required": ["type", "file"],
                  "additionalProperties": false,
                  "description": "Service definition"
                }
              ]
            }
          },
          "env": {
            "description": "Global environment variables",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "setup": {
            "description": "Commands to run once before starting template services",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prompts": {
            "description": "Paths to prompt files or directories (relative to workspace root)",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "agent": {
            "description": "Agent configuration for this template",
            "type": "object",
            "properties": {
              "model": {
                "description": "Model configuration for this template",
                "type": "object",
                "properties": {
                  "providerId": {
                    "description": "OpenCode provider identifier",
                    "type": "string"
                  },
                  "id": {
                    "description": "Model identifier within the provider",
                    "type": "string"
                  },
                  "variant": {
                    "description": "Optional model variant identifier",
                    "type": "string"
                  }
                },
                "required": ["providerId", "id"],
                "additionalProperties": false
              },
              "providerId": {
                "description": "Deprecated: OpenCode provider identifier",
                "type": "string"
              },
              "modelId": {
                "description": "Deprecated: model identifier within the provider",
                "type": "string"
              },
              "variant": {
                "description": "Deprecated: model variant identifier",
                "type": "string"
              },
              "agentId": {
                "description": "Agent preset identifier",
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "teardown": {
            "description": "Cleanup commands on cell deletion or provisioning rollback",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "includePatterns": {
            "description": "Patterns to include from gitignored files for worktree copying (e.g., '.env', '*.local')",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ignorePatterns": {
            "description": "Glob patterns to skip when copying included files into worktrees",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["id", "label", "type"],
        "additionalProperties": false,
        "description": "Template definition"
      }
    },
    "defaults": {
      "description": "Default values for cell creation",
      "type": "object",
      "properties": {
        "templateId": {
          "description": "Default template to use when creating cells",
          "type": "string"
        },
        "startMode": {
          "description": "Default OpenCode agent mode for new cells",
          "type": "string",
          "enum": ["plan", "build"]
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["promptSources", "templates"],
  "additionalProperties": false
}
