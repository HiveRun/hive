HIVE_INSTANCE_NAME=Private Remote Hive
HIVE_PUBLIC_API_URL=https://hive.example.com
HIVE_PUBLIC_WEB_URL=https://hive.example.com

# Optional: publish Hive to localhost on the Docker host for smoke tests.
HIVE_LOCAL_PORT=3000

# Mount your OpenCode config/provider credentials into the container.
HIVE_OPENCODE_CONFIG_DIR=./opencode

# Required only when using docker-compose.cloudflare.yml.
CLOUDFLARE_TUNNEL_TOKEN=
