{
  "$schema": "https://raw.githubusercontent.com/kucherenko/jscpd/master/schemas/jscpd-schema.json",
  "pattern": "**/*.{ts,tsx,js,jsx,mjs,cjs}",
  "ignore": [
    "**/node_modules/**",
    "**/.turbo/**",
    "**/.cache/**",
    "**/coverage/**",
    "**/*.tsbuildinfo",
    "**/dist/**",
    "**/build/**",
    "**/dist-electron/**",
    "dist/install/**",
    "apps/server/server/**",
    "apps/desktop-electron/out/**",
    "apps/desktop-electron/public/**",
    ".hive/**",
    ".opencode/plans/**",
    ".opencode/state/**",
    ".opencode/themes/**",
    ".opencode/tools/**",
    "tmp/**",
    "temp/**",
    "**/*.db",
    "**/*.sqlite",
    "**/*.log",
    "apps/e2e/reports/**",
    "apps/e2e-desktop/reports/**",
    "apps/web/test-results/**",
    "apps/web/playwright-report/**",
    "apps/web/e2e/**/__snapshots__/**",
    "apps/web/src/routeTree.gen.ts",
    "**/*.generated.ts",
    "AGENTS.md",
    "CLAUDE.md",
    ".ruler/01-readme.md",
    "apps/server/src/migrations/**",
    "bun.lock"
  ],
  "reporters": ["json"],
  "threshold": 0,
  "maxLines": 10000,
  "maxSize": "5mb",
  "mode": "strict",
  "gitignore": true
}
