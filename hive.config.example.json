{
  "$schema": "./hive.config.schema.json",
  "opencode": {
    "defaultProvider": "zen",
    "defaultModel": "big-pickle",
    "defaultMode": "plan"
  },
  "promptSources": [
    "https://raw.githubusercontent.com/HiveRun/hive/refs/heads/main/docs/prompts/**/*.md"
  ],
  "templates": {
    "basic": {
      "id": "basic",
      "label": "Basic Template",
      "type": "manual",
      "includePatterns": ["./.env*"],
      "ignorePatterns": [
        "node_modules/**",
        ".hive/**",
        ".opencode/state/**",
        ".opencode/themes/**",
        ".turbo/**",
        "tmp/**",
        "temp/**",
        ".cache/**",
        "coverage/**",
        "dist/**",
        "build/**",
        "dist-electron/**",
        "apps/server/server/**"
      ],
      "agent": {
        "model": {
          "providerId": "zen",
          "id": "big-pickle"
        }
      },
      "services": {
        "api": {
          "type": "process",
          "run": "bun run dev",
          "cwd": "./apps/server",
          "ports": {
            "http": {
              "primary": true,
              "protocol": "http"
            },
            "metrics": {
              "protocol": "tcp"
            }
          },
          "env": {
            "NODE_ENV": "development",
            "DATABASE_URL": "./dev.db",
            "METRICS_PORT": "${PORT:api:metrics}"
          },
          "readiness": {
            "checks": [
              {
                "type": "http",
                "port": "http",
                "path": "/health"
              }
            ]
          },
          "readyTimeoutMs": 5000
        }
      },
      "teardown": ["bun run dev:teardown"]
    }
  }
}
