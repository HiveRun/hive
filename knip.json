{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "AGENTS.md",
    "CLAUDE.md",
    ".hive/**",
    ".opencode/plans/**",
    ".opencode/state/**",
    ".opencode/themes/**",
    ".opencode/tools/**",
    ".ruler/01-readme.md",
    "**/*.generated.ts",
    "**/*.tsbuildinfo",
    "apps/desktop-electron/out/**",
    "apps/desktop-electron/public/**",
    "apps/e2e/reports/**",
    "apps/e2e-desktop/reports/**",
    "apps/server/server/**",
    "apps/server/src/migrations/**",
    "apps/web/e2e/**/__snapshots__/**",
    "apps/web/playwright-report/**",
    "apps/web/test-results/**",
    "build/**",
    "coverage/**",
    "dist/**",
    "dist-electron/**",
    "temp/**",
    "tmp/**"
  ],
  "ignoreIssues": {
    "apps/server/src/agents/tools/hive.ts": ["exports"]
  },
  "workspaces": {
    ".": {
      "entry": [
        ".opencode/plugin/**/tools.ts",
        "*.config.{js,ts,mjs,cjs}",
        "package.json",
        "scripts/**/*.{js,ts,mjs,cjs}"
      ],
      "project": [
        ".opencode/plugin/**/*.ts",
        "*.{js,ts,mjs,cjs,json}",
        "scripts/**/*.{js,ts,mjs,cjs}"
      ]
    },
    "apps/web": {
      "entry": [
        "package.json",
        "src/main.tsx",
        "src/index.css",
        "src/router.tsx",
        "src/routes/**/*.{ts,tsx}",
        "vite.config.ts",
        "vitest.config.ts"
      ],
      "project": [
        "*.{js,ts,mjs,cjs}",
        "src/**/*.{ts,tsx,css}",
        "e2e/**/*.{ts,tsx}"
      ]
    },
    "apps/server": {
      "entry": [
        "package.json",
        "drizzle.config.ts",
        "src/index.ts",
        "src/server.ts",
        "src/scripts/**/*.ts",
        "src/**/*.test.ts",
        "tsdown.config.ts",
        "vitest.config.ts"
      ],
      "project": ["*.{js,ts,mjs,cjs}", "src/**/*.ts"]
    },
    "apps/e2e": {
      "entry": [
        "package.json",
        "playwright.config.ts",
        "specs/**/*.ts",
        "src/runtime/**/*.ts"
      ],
      "project": ["**/*.ts"]
    },
    "apps/e2e-desktop": {
      "entry": [
        "package.json",
        "playwright.config.ts",
        "specs/**/*.ts",
        "src/runtime/**/*.ts"
      ],
      "project": ["**/*.ts"]
    },
    "apps/desktop-electron": {
      "entry": [
        "package.json",
        "scripts/**/*.ts",
        "src/main.ts",
        "src/preload.ts",
        "tsdown.config.ts"
      ],
      "ignoreBinaries": ["electron"],
      "project": ["*.{js,ts,mjs,cjs}", "scripts/**/*.ts", "src/**/*.ts"]
    },
    "packages/cli": {
      "entry": ["package.json", "src/index.ts", "vitest.config.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/daemon-runtime": {
      "entry": ["package.json", "src/index.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
